#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define LOWER 1
#define RAISE 2
#define MOUSE 3
#define BOT bootloader

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        tdRMCLK: tap_dance_R_LMouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp RCLK>, <&mkp MCLK>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {
        LMouse_sc: behavior_LMouse_Scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &mkp>;        /* hold=none, tap=Lmouse */
        };
    };

    behaviors {
        M_kp: behavior_mouse_keypress {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&mkp &kp>;        /* hold=mou key press, tap=key*/
        };
    };

    behaviors {
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESC    &kp Q  &kp W         &kp E       &kp R         &kp T      &kp Y      &kp U      &kp I               &kp O                &kp P       &kp BSPC
&kp TAB    &kp A  &kp S         &kp D       &kp F         &kp G      &mkp LCLK  &mkp LCLK  &kp H               &kp J                &kp K       &kp L      &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z  &kp X         &kp C       &kp V         &kp B      &kp PG_DN  &kp PG_UP  &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &kp N       &kp M      &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
&kp LCTRL  &mo 2  &kp LEFT_GUI  &kp C_MUTE  &kp LEFT_ALT  &kp SPACE  &mo 1      &mo 1      &mo 2               &kp LEFT_GUI         &kp C_MUTE  &kp MINUS  &kp EQUAL  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LEFT RIGHT>;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
&kp GRAVE       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N         &kp M  &none      &none      &none       &none         &none         &kp DEL
&kp CAPS        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &none         &none  &mkp RCLK  &mkp RCLK  &none       &none         &none         &none    &kp SQT   &kp ENTER
&kp LEFT_SHIFT  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &none  &trans     &trans     &bl BL_DEC  &bl BL_INC    &none         &none    &kp LBKT  &kp RBKT   &kp NUBS  &kp RIGHT_SHIFT
&kp LCTRL       &none         &kp LEFT_GUI  &bt BT_CLR    &kp LEFT_ALT  &none  &none      &none      &none       &kp LEFT_GUI  &out OUT_TOG  &none    &none     &kp RCTRL
            >;

            sensor-bindings = <&BLE_encoder &inc_dec_kp UP DOWN>;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
&kp ESC    &kp F1  &kp F2        &kp F3  &kp F10       &none  &mkp MB1  &mkp MB2  &none  &none         &none  &kp BACKSPACE
&kp CAPS   &kp F4  &kp F5        &kp F6  &kp F11       &none  &none     &none     &none  &mkp MB3      &none  &none          &none  &kp ENTER
&kp LSHFT  &kp F7  &kp F8        &kp F9  &kp F12       &none  &none     &none     &none  &none         &none  &none          &none  &none      &none  &kp RIGHT_SHIFT
&kp LCTRL  &none   &kp LEFT_GUI  &none   &kp LEFT_ALT  &none  &none     &none     &none  &kp LEFT_GUI  &none  &none          &none  &kp RCTRL
            >;
        };

        MOUSE_layer {
            display-name = "MOUSE";
            bindings = <
&kp ESC    &none  &none         &none  &none         &none  &mkp MB1        &mkp MB2      &none     &none         &none  &kp BSPC
&kp TAB    &none  &none         &none  &none         &none  &mkp LCLK       &mkp LCLK     &none     &mkp MB3      &none  &none     &none  &kp ENTER
&kp LSHFT  &none  &none         &none  &none         &none  &msc SCRL_DOWN  &msc SCRL_UP  &none     &none         &none  &none     &none  &none      &none  &kp RSHFT
&kp LCTRL  &none  &kp LEFT_GUI  &none  &kp LEFT_ALT  &none  &none           &none         &tdRMCLK  &kp LEFT_GUI  &none  &none     &none  &kp RCTRL
            >;
        };

        RES_layer {
            display-name = "RESERVE";
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
